ENVIRONMENT=development
DEBUG=true
JWT_SECRET=change-me-in-production
JWT_ISSUER=aubit-backend
JWT_AUDIENCE=aubit-clients
JWT_EXPIRY_MINUTES=60
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000,null,file://
ALLOWED_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?$|^null$

MONGODB_URI=
MONGODB_DATABASE=aubit
REDIS_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
STRIPE_API_KEY=
GCP_STORAGE_BUCKET=
GCP_CREDENTIALS_PATH=
SENTRY_DSN=

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
